OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_VOICE=shimmer

SARVAM_API_KEY=

# Only needed for -t twilio / TELEPHONY_TRANSPORT=twilio testing (not used by
# Exotel). Account SID + Auth Token from the Twilio Console's Account Info
# panel (https://console.twilio.com — top of the dashboard), not something
# generated per-call. Read directly by pipecat's own runner via os.getenv
# (pipecat.runner.utils._create_telephony_transport), not by app/config/settings.py.
# Required, not optional: TwilioFrameSerializer validates these at call-start
# (auto_hang_up defaults on) and raises if either is missing — a Twilio call
# would fail to connect at all without them, not just fail to auto-hang-up.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Used directly by the live-call tools (logInteraction, check_availability,
# book_table) to read/write the sheet, and by /admin to read it. Reuses the
# same service account already granted Editor on the sheet for n8n's own
# credential — no separate sharing step needed. The spreadsheet needs two
# tabs: "Sheet1" (interaction log — Timestamp, CallDate, CallerName,
# CallerPhone, Topic, Resolved, Details, GuestsCount, Drift, CallConfidence)
# and "Bookings" (Timestamp, BookingId, Date, Time, GuestsCount, CallerName,
# CallerPhone, Status), each with just the header row already in place.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Required once this is reachable off localhost.
ADMIN_USERNAME=
ADMIN_PASSWORD=
