OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_VOICE=shimmer

SARVAM_API_KEY=

# Same restaurant-log-interaction webhook the existing Vapi/n8n workflow uses.
N8N_WEBHOOK_URL=

# /admin — reads the same Google Sheet n8n writes to. Reuses the same
# service account already granted Editor on the sheet for n8n's credential.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Required once this is reachable off localhost.
ADMIN_USERNAME=
ADMIN_PASSWORD=
