# gpt-4.1-mini: 25/25 on the eval suite (twice) vs gpt-5.6-luna's 19/25 --
# luna kept re-asking for details the caller had already given in one
# sentence ("table for two Monday at 8, I'm Priya" -> "What date?"). See
# TROUBLESHOOTING.md's "Conversational LLM model choice" section before
# changing this. app/main.py's startup probe decides per model whether
# reasoning_effort="none" is sent (gpt-4.1-mini rejects it; that's fine).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TTS_VOICE=echo

# Conversational LLM, tried in place of OpenAI for faster completions
# (Groq's LPU inference vs. hosted GPU serving) — see app/main.py's
# _build_llm. OPENAI_API_KEY above is still required regardless: the
# logInteraction backfill call and the TTS fallback path both always use
# OpenAI directly.
#
# GROQ_ENABLED must be explicitly "true" (not just having a key set) — the
# free/on-demand Groq tier rate-limits at 8000 tokens/minute, and this
# bot's system prompt alone is ~4-5K tokens/turn. Measured 47-58s per real
# turn once that budget is used up, vs. ~1-2s on OpenAI. Only enable after
# upgrading the Groq billing tier and re-verifying actual per-turn latency
# on a real call.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

SARVAM_API_KEY=

# STT alternative to Sarvam, and TTS alternative to Rumik/Sarvam/OpenAI
# (Flux voice flux-naveen-en — the only Indian-accented male voice Deepgram
# offers, their stable Aura-2 line has none) — see app/services/
# stt_factory.py + tts_factory.py and Restaurant.stt_provider/tts_provider
# (app/config/restaurants/*.py) for how a restaurant picks one.
# console.deepgram.com; $200 free credit on a new account.
DEEPGRAM_API_KEY=

# Rumik Silk (silk-api.rumik.ai), mulberry model — TTS only, no STT product.
# Chosen over OpenAI TTS for Hindi/English code-mixed restaurant speech; see
# app/services/rumik_tts.py and Restaurant.tts_provider for switching to
# Sarvam, OpenAI, or Deepgram TTS instead (app/services/tts_factory.py).
RUMIK_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Real Plivo only (not Vobiz, which needs no Plivo creds — see /answer vs
# /plivo-answer in app/main.py). console.plivo.com dashboard home page,
# top-left. Used to hang up calls via Plivo's REST API, required because
# real Plivo's <Stream keepCallAlive="true"> (needed so the call survives
# to begin with) means our own WebSocket closing no longer ends the call.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# SMS-capable Twilio number (E.164) that sends real-time alert texts — used
# for BOTH of these, independent of whichever provider actually carries the
# call (Exotel/Twilio/Vobiz):
#   - human escalation: app/tools/log_interaction.py texts Restaurant.owner_phone
#     (set per-client in app/config/restaurants/*.py) the moment a topic is
#     logged resolved=false — caller asked for a human, or the bot couldn't help.
#   - ops alerting: app/pipeline/call_health.py texts OPS_ALERT_PHONE below the
#     instant a live call is degraded/ended due to an unrecoverable STT/LLM/TTS
#     failure — real-time, not just the CALL_HEALTH_DEVELOPER_ALERT log line.
# Leave either destination number unset and that alert path just stays off.
TWILIO_SMS_FROM_NUMBER=
OPS_ALERT_PHONE=

# Free owner WhatsApp alerts (CallMeBot) — sent to Restaurant.owner_phone
# alongside the SMS above when a topic is unresolved, then again at call end
# with the summary + recording link. One-time setup from the OWNER's phone:
# WhatsApp "I allow callmebot to send me messages" to CallMeBot's number
# (https://www.callmebot.com/blog/free-api-whatsapp-messages/) and paste the
# key it replies with. Per-restaurant override: _<restaurant_id> suffix.
WHATSAPP_CALLMEBOT_APIKEY=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Call recordings, ACTIVE backend for now: Drive, authorized as your own
# Google account via OAuth (not a service account — service accounts have
# had zero Drive storage quota since 2021, confirmed live via
# storageQuotaExceeded on an actual upload attempt).
#   1. console.cloud.google.com, same project as the service account above.
#      APIs & Services -> OAuth consent screen -> configure if not already
#      done (App name, your email as User support + a Test user — Testing
#      publishing status is fine, only your own account needs to consent).
#   2. APIs & Services -> Credentials -> Create Credentials -> OAuth client
#      ID -> Application type "Desktop app" -> gives you the two values
#      below immediately.
#   3. Set the two values, then run `python -m app.services.drive_oauth_setup`
#      — opens a browser for a one-time consent grant, prints
#      GOOGLE_OAUTH_REFRESH_TOKEN to paste in below. After this it's fully
#      unattended; recordings land in a "Call Recordings" folder the app
#      creates in your Drive on first use.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Call recordings, LONGER-TERM backend (not active yet) — Cloudflare R2,
# S3-compatible object storage with no per-identity quota model to run into.
# Parked here until R2 is actually activated on the Cloudflare account (an
# API token alone isn't enough — R2 itself needs enabling in the dashboard;
# without that the storage endpoint TLS-rejects every request). Once it's
# live, swap app/pipeline/recording.py's import back to r2_client.
#   1. dash.cloudflare.com -> R2 Object Storage -> Enable R2 -> create a
#      bucket (e.g. "spice-route-recordings").
#   2. Manage R2 API Tokens -> Create API Token -> Object Read & Write,
#      scoped to that bucket -> gives you the access key ID + secret below.
#   3. Account ID is shown on the R2 overview page.
#   4. Optional: bucket Settings -> Public Access -> enable the r2.dev
#      subdomain (or connect a custom domain) for R2_PUBLIC_URL_BASE, so
#      RecordingURL in the sheet is a clickable link. Leave unset and it
#      still logs a valid object key, just not a clickable one. Note this
#      makes recordings reachable by anyone with the link (filenames aren't
#      guessable, but there's no auth check) — fine for now, revisit if
#      tighter access control matters later.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=

# The spreadsheet needs a third tab, "Recordings" (Timestamp, CallSessionId,
# CallerPhone, DurationSecs, RecordingURL, Transcript, Summary), header row
# only — already set up on the live sheet as of the recording feature's
# initial build.

ADMIN_USERNAME=
ADMIN_PASSWORD=

# Call tracing (STT/LLM/TTS latency, turn spans) via Langfuse's OTel
# endpoint — see app/pipeline/tracing.py. Leave unset to keep tracing off.
# Get keys from a Langfuse project (cloud.langfuse.com, free Hobby tier).
# LANGFUSE_HOST defaults to the EU cloud host; override for US/JP/HIPAA.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- admin_service/ (standalone superadmin + per-restaurant dashboards) ---
# Separate deployment from the bot above (own Dockerfile, port 8081) — set
# these on THAT Railway service, not this one. Reuses the same
# GOOGLE_SERVICE_ACCOUNT_EMAIL / GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY from
# above (same service account, read-only Sheets scope) — just needs those
# two set in this service's own environment too. Restaurant registry
# (display name, dashboard path, Sheet ID) lives in admin_service/config.yaml,
# not here; only per-restaurant admin logins are secrets, so only those are
# env vars. Leaving a pair unset leaves that dashboard open with no login —
# don't expose the service publicly until these are set.
ZERO40_ADMIN_USERNAME=
ZERO40_ADMIN_PASSWORD=
SPICE_ADMIN_USERNAME=
SPICE_ADMIN_PASSWORD=
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
