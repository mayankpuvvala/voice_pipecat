# Env vars this service actually reads. Names must match config.yaml's
# *_env fields exactly. Leave unset locally to run with auth open (see
# config.py's resolve_credentials docstring) — set real values before this
# is reachable on a public URL.

# Shared read-only Sheets access: one service account, granted Viewer on
# BOTH restaurants' Google Sheets (Share -> paste this account's email).
# Same credential shape as the bot's own GOOGLE_SERVICE_ACCOUNT_* vars —
# this service only ever reads, never writes, so a fresh minimal-scope
# service account is fine; it does not need to be the same one the bot uses.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Per-restaurant dashboard logins (Basic Auth) — each pair scoped to only
# that restaurant's own /zero or /spice page.
ZERO40_ADMIN_USERNAME=
ZERO40_ADMIN_PASSWORD=
SPICE_ADMIN_USERNAME=
SPICE_ADMIN_PASSWORD=

# Super-admin login for /admin — sees both restaurants combined.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
